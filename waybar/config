{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    
    "modules-left": ["sway/window"],
    "modules-center": ["sway/workspaces"],
    "modules-right": ["clock", "network", "custom/power"],

    "sway/window": {
        "format": "{}",
        "tooltip": false,
        "max-length": 40
    },

    "sway/workspaces": {
        "tooltip": false,
        "disable-scroll": true,
        "all-outputs": true,
        "format": "",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "clock": {
        "format": "{:%d-%m-%Y %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#89b4fa'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'>{}</span>",
                "weeks": "<span color='#94e2d5'><b>W{}</b></span>",
                "weekdays": "<span color='#6c7086'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "network": {
        "tooltip": false,
        "format": "{ifname}",
        "format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "format-disconnected": "Disconnected",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "sh $HOME/.config/waybar/scripts/rofi-wifi.sh"
    },

    "custom/power": {
        "tooltip": false,
        "format": "Power",
        "on-click": "sh $HOME/.config/waybar/scripts/rofi-power.sh"
    }
}
