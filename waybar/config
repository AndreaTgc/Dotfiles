{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    
    "modules-left": [],
    "modules-center": ["sway/workspaces"],
    "modules-right": ["clock", "network", "custom/power"],

    "sway/workspaces": {
        "tooltip": false,
        "disable-scroll": true,
        "all-outputs": true,
        "format": "",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "network": {
        "tooltip": false,
        "format": "{ifname}",
        "format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "format-disconnected": "Disconnected",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "sh $HOME/.config/waybar/scripts/rofi-wifi.sh"
    },

    "custom/power": {
        "tooltip": false,
        "format": "Power",
        "on-click": "sh $HOME/.config/waybar/scripts/rofi-power.sh"
    }
}
