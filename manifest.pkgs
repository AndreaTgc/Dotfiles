##################################################
# Common Packages.                               #
# These packages are some essentials that i want #
# to have installed on all my systems            #
# 'cask' and 'pkg' have the same effect on linux #
# systems. they are only needed for MacOS.       #
# NOTE: only Arch supported as linux for now     #
##################################################

pkg ripgrep
pkg bat
pkg git
pkg tree
pkg btop
pkg fzf
pkg fd
pkg eza
pkg zoxide
pkg jq
pkg tmux
pkg zig
pkg odin
pkg lua
pkg rustup
pkg typst
pkg nvim
pkg zsh
cask alacritty
cask firefox

# Note: these are not meant to be platform specific
# but there are some naming inconsistencies between
# systems. so they end up here

pkg:macos jj
pkg:arch jujutsu
pkg:macos gh
pkg:arch github-cli

##################################################
# Arch specific tools.                           #
# This section contains some packages that only  #
# come with arch/linux systems, things like WMs  #
# and other configuration tools for the desktop  #
# environment can only be installed here         #
##################################################

pkg:arch sway
pkg:arch waybar
pkg:arch rofi

##################################################
# MacOS specific applications.                   #
# These packages are meant to be installed only  #
# on MacOS systems as they may not be present on #
# linux systems                                  #
##################################################

cask:macos claude-code
cask:macos vscodium

##################################################
# Configuration symlinks.                        #
# These link definitions are just to deploy the  #
# dotfiles stored in the repo to their correct   #
# locations on the system                        #
##################################################

link zsh/zprofile ~/.zprofile
link zsh/zshrc ~/.zshrc
link nvim ~/.config/nvim
link alacritty ~/.config/alacritty
link:arch sway ~/.config/sway
link:arch waybar ~/.config/waybar
link:arch rofi ~/.config/rofi
