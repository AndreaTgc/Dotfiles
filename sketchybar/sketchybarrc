#!/bin/bash

source "$HOME/.config/sketchybar/colors.sh"
FONT="IosevkaTerm Nerd Font"
PLUGINS="$HOME/.config/sketchybar/plugins"

##
# Default bar position and padding
##

sketchybar --bar \
  position=top height=30 \
  color=$BG \
  padding_left=8 padding_right=8 \
  shadow=off

##
# Default values for all items if not overridden
##

sketchybar --default \
  icon.font="$FONT:Regular:13.0" \
  icon.color=$FG \
  icon.highlight_color=$ACCENT \
  label.font="$FONT:Bold:13.0" \
  label.color=$FG \
  padding_left=4 padding_right=4 \
  icon.padding_left=8 icon.padding_right=4 \
  label.padding_left=4 label.padding_right=8 \
  background.color=$BG_ALT \
  background.border_color=$ACCENT \
  background.border_width=1 \
  background.corner_radius=4 \
  background.height=22

##
# Display the name of the current app
##

sketchybar --add item front_app left \
  --set front_app \
     icon.drawing=off \
     label.color=$FG \
     script="sh $PLUGINS/front_app.sh" \
  --subscribe front_app front_app_switched

##
# Display current active space with aerospace
# Each space is an item that can either be full or empty 
##

# Declare the custom event before anything subscribes to it
sketchybar --add event aerospace_workspace_change
SPACES=5
AEROSPACE="/Users/andreacolombo/Binaries/aerospace/bin/aerospace"
for i in $(seq 1 $SPACES); do
  sketchybar --add item space.$i center \
    --set space.$i \
      icon="○" \
      icon.padding_left=4 \
      icon.padding_right=4 \
      label.drawing=off \
      background.border_color=$BG \
      background.color=$BG \
      script="sh $PLUGINS/space.sh" \
      click_script="$AEROSPACE workspace $i" \
    --subscribe space.$i aerospace_workspace_change
done

##
# Display connected wifi (or disconnected) 
##

sketchybar --add item wifi right \
  --set wifi \
    icon="" \
    update_freq=30 \
    script="sh $PLUGINS/wifi.sh"

##
# Display battery state
##

sketchybar --add item battery right \
  --set battery \
    icon="󱊣" \
    icon.color=$DIM \
    label.color=$FG \
    update_freq=1 \
    script="sh $PLUGINS/battery.sh"

##
# Display clock with minutes precision
##

sketchybar --add item time right \
  --set time \
    icon="󱑈" \
    icon.color=$DIM \
    label.color=$FG \
    update_freq=60 \
    script="sh $PLUGINS/clock.sh"

##
# Show current CPU load
##

sketchybar --add item cpu right \
  --set cpu \
    icon="CPU: " \
    update_freq=10 \
    script="sh $PLUGINS/cpu.sh"

sketchybar --update

# Draw the correct state once at load
sketchybar --trigger aerospace_workspace_change
