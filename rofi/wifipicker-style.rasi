@import "colors.rasi"

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 8px;
    width: 360px;
    padding: 12px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 6px;
    padding: 8px 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "";
    placeholder-color: @muted;
}

listview {
    lines: 6;
    spacing: 4px;
    fixed-height: false;
    scrollbar: false;
}

element {
    padding: 6px 10px;
    border-radius: 6px;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}
